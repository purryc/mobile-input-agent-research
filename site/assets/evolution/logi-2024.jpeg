				</style><style id="wp-custom-css">
.jnews_comment_container, #respond {
    display: none;
}

h3:contains('Related Posts') + article:nth-of-type(-n+5) {
    display: none;
}
.jeg_thumb img,
.jeg_postblock .jeg_thumb img {
    border-radius: 12px;
}
.jeg_postblock_content .jeg_thumb,
.jeg_thumb a {
    border-radius: 12px;
    overflow: hidden; /* needed so the image corners actually clip */
}

/* Change main navigation text transform Trung 27 aug 2026*/
.jeg_navigation a, 
.jeg_main_menu a {
    text-transform: none !important; /* Retains exact text casing typed in WP Menus */
}

/* Change LOGITECH button text transform to display as typed (Title Case) */
.jeg_nav_item.jeg_button_1 a {
    text-transform: capitalize !important; /* Forces Title Case */
}


/* Change BUSINESS link text transform to display in Title Case */
.jeg_nav_item.jeg_button_1 a,
.jeg_top_bar a,
.jeg_nav_item a {
    text-transform: capitalize !important;
}



/* Add rounded corners to the main slider image */
.jeg_slide_item,
.jeg_slide_image {
    border-radius: 12px !important;
    overflow: hidden !important;
}

/* Change slider image container background to white */
.jeg_slide_item,
.jeg_slide_image {
    background-color: #ffffff !important;
}


/* Inherit standard site typography for post categories */
.jeg_post_category a {
    font-family: inherit !important;
    font-weight: inherit !important;
    text-transform: inherit !important;
    letter-spacing: inherit !important;
}


/* Optional: Keep dark gray/black on hover */
.jeg_readmore:hover {
    color: #333333 !important;
}

/* Change text color inside category badges */
.jeg_post_category a,
.jeg_post_category span a,
div.jeg_post_category a[class*="category-"] {
    color: #000000 !important;
}

/* Maintain black text when hovering over the category button */
.jeg_post_category a:hover,
.jeg_post_category span a:hover,
div.jeg_post_category a[class*="category-"]:hover {
    color: #000000 !important;
    opacity: 0.85 !important;
}


/* Apply 12px rounded corners to YouTube video containers and iframe elements */
.jeg_post_featured iframe,
.jeg_video_container iframe,
.jeg_postblock iframe,
iframe[src*="youtube.com"] {
    border-radius: 12px !important;
    overflow: hidden !important;
}

/* Ensure the outer wrapper clips any overflow background */
.jeg_post_featured,
.jeg_video_container,
.jeg_postblock_content {
    border-radius: 12px !important;
}



/* Override Elementor icon list footer links to stay black and underline on hover */
.elementor-widget-icon-list .elementor-icon-list-item a:hover .elementor-icon-list-text,
.elementor-widget-icon-list .elementor-icon-list-item a:hover,
.elementor-footer-content .elementor-icon-list-item a:hover {
    color: #000000 !important;
    text-decoration: underline !important;
}




/* JNews Load More Button - Larger Text & Flex Centered */
.jeg_block_loadmore,
.jnews-block-loadmore {
    text-align: center !important;
    margin: 40px auto !important;
    clear: both !important;
    width: 100% !important;
}

.jeg_block_loadmore a,
.jnews-block-loadmore a,
a.jnews-loadmore-btn,
.jeg_loadmore_btn {
    background-color: #00FDCF !important;
    color: #000000 !important;
    border: none !important;
    
    /* Font Sizing */
    font-size: 14px !important;            /* Increase font size (default is usually ~12-14px) */
    font-weight: 700 !important;
    letter-spacing: 1px !important;       /* Adds subtle spacing for readability */
    
    /* Centering & Dimensions */
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    line-height: 1 !important;
    height: 52px !important;               /* Slightly taller container to fit larger text */
    padding: 0 42px !important;
    border-radius: 60px !important;
    width: auto !important;
    max-width: fit-content !important;
    box-sizing: border-box !important;
}

/* Hover State */
.jeg_block_loadmore a:hover,
.jnews-block-loadmore a:hover,
a.jnews-loadmore-btn:hover,
.jeg_loadmore_btn:hover {
    background-color: #00e0b8 !important;
    color: #000000 !important;
    opacity: 0.95;
}



/* Code for rounded images in posts */

/* Container clipping for grid thumbnails */
.jnews_module_thumb,
.jeg_thumb,
.jeg_postblock .jeg_thumb a {
    border-radius: 12px !important;
    overflow: hidden !important;
    display: block !important;
}

/* Image rounding across grid and post content */
img.wp-post-image,
.entry-content img, 
.post-content img {
    border-radius: 12px !important;
    display: block !important;
}




/* Reduce button font size globally to 14px */
button,
input[type="button"],
input[type="submit"],
input[type="reset"],
.btn,
.jnews-btn,
.button,
.elementor-button,
.jeg_videoblock_more,
.jeg_videoblock_more a,
.jeg_block_more,
.jeg_block_more a,
.jeg_videoblock_more span {
    font-size: 14px !important;
}

/* Force Logitech Brown Web Pan font site-wide */
body, 
p, 
a, 
h1, h2, h3, h4, h5, h6, 
.jeg_post_title, 
.jeg_block_title, 
.elementor-widget {
    font-family: 'Logitech Brown Web Pan', 'Logitech Brown', 'LogitechBrown', sans-serif !important;
}



/* Override Watch More button typography and height */
.jnews_inline_related_posts .watch-more-btn,
a[href*="youtube.com"],
.work-and-play-section a.button { /* Replace with exact parent class if custom */
    font-size: 14px !important; /* Adjust to desired size */
    line-height: 1.2 !important;
    min-height: unset !important;
    padding: 8px 16px !important;
}


/* 1. Ensure normal heading layout without hiding structural wrappers */
.jeg_block_heading,
.jeg_block_title,
.jeg_post_title,
.jeg_hero_style_1 .jeg_post_title {
    border-bottom: none !important;
    box-shadow: none !important;
}

/* Remove all horizontal decorative lines on block headings and post titles */
.jeg_block_heading,
.jeg_block_title,
.jeg_post_title,
.jeg_hero_style_1 .jeg_post_title,
.jeg_block_heading span,
.jeg_block_title span,
.jeg_block_heading:before,
.jeg_block_heading:after,
.jeg_block_title:before,
.jeg_block_title:after,
.jeg_post_title:before,
.jeg_post_title:after {
    border: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    background: transparent !important;
    height: auto !important;
}

/* 3. Style READ MORE buttons cleanly as pill buttons with exact hex #00FDCF */
.jeg_hero_style_1 .jeg_readmore,
.jeg_post_block .jeg_readmore,
.jeg_pl_md_1 .jeg_readmore,
a.jeg_readmore {
    display: inline-block !important;
    position: relative !important;
    margin-top: 15px !important;
    padding: 8px 22px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
    border-radius: 50px !important;
    border: 1px solid #00FDCF !important;
    background-color: #00FDCF !important;
    color: #000000 !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out !important;
}

/* Hover state */
a.jeg_readmore:hover {
    background-color: #000000 !important;
    border-color: #000000 !important;
    color: #ffffff !important;
}


/* Remove decorative border line above post excerpt in JNews hero/sliders */
.jeg_post_excerpt,
.jeg_hero_style_1 .jeg_post_excerpt,
.jeg_slider_type_7 .jeg_post_excerpt,
.jeg_postblock .jeg_post_excerpt {
    border-top: none !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
}

/* Hide decorative border-top or pseudo-elements on post content wrappers */
.jeg_post_meta:before,
.jeg_post_excerpt:before {
    display: none !important;
    content: none !important;
}

/* Keep post title links black on mouseover / hover without underline */
.jeg_post_title a:hover,
.jeg_post_title a:focus,
.jeg_hero_style_1 .jeg_post_title a:hover,
.jeg_heroblock .jeg_post_title a:hover,
.jeg_pl_md_card .jeg_post_title a:hover,
.entry-header .entry-title a:hover {
    color: #000000 !important;
    text-decoration: none !important;
}

/* 1. Set author links across archive & listing pages to black */
.jeg_post_meta .jeg_meta_author a,
.jeg_meta_author a,
.jeg_meta_author,
.jeg_pl_md_box .jeg_meta_author a,
.jeg_pl_sm .jeg_meta_author a {
    color: #000000 !important;
}

/* 2. Hover state for listing pages */
.jeg_post_meta .jeg_meta_author a:hover,
.jeg_meta_author a:hover {
    color: #333333 !important;
}

/* 3. Keep author links white on single post hero headers */
.single-post .entry-header .jeg_meta_author,
.single-post .entry-header .jeg_meta_author a,
.single-post .entry-header .jeg_meta_author a span,
.single-post .entry-header .meta_left .jeg_meta_author a {
    color: #ffffff !important;
}

/* 4. Single post hero hover state */
.single-post .entry-header .jeg_meta_author a:hover {
    color: #cccccc !important;
}
</style>
